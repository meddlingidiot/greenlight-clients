<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tool that makes a listing. Point the frame at your client, take a still, optionally
    record a loop, answer five questions, and it writes listings/<slug>/ ready to commit.

    It lives in this repository rather than its own so the form and
    schema/listing.schema.json cannot drift: when the schema gains a field, the form gains it
    in the same commit.

    net10.0-windows because the viewfinder is a Win32 window region and the capture is
    BitBlt. The clients this photographs are Windows apps, so that costs nothing.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Greenlight.GalleryCapture</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <!--
    The SDK does two things here. It tells the truth in one field: last-verified.greenlight
    is supposed to be the Greenlight version you actually ran against, and asking the running
    Greenlight beats asking the contributor to go and look. And it drives the state buttons:
    hold_indicators (SDK 1.2.0, Greenlight 1.0.20) makes every indicator on the machine go
    red, or blink, on request, so a clip can show the client doing its job without waiting
    for a build to break.

    The package, except when the SDK repository is checked out beside this one — then the
    project, so a change to the contract can be tried from here before it is published.
    Pass -p:UseGreenlightSdkProject=false to build against the package regardless.
  -->
  <PropertyGroup>
    <GreenlightSdkProject Condition="'$(GreenlightSdkProject)' == ''">..\..\MeddlingIdiot.Greenlight.Sdk\Greenlight.Sdk\Greenlight.Sdk.csproj</GreenlightSdkProject>
    <UseGreenlightSdkProject Condition="'$(UseGreenlightSdkProject)' == '' And Exists('$(GreenlightSdkProject)')">true</UseGreenlightSdkProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseGreenlightSdkProject)' == 'true'">
    <ProjectReference Include="$(GreenlightSdkProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseGreenlightSdkProject)' != 'true'">
    <PackageReference Include="MeddlingIdiot.Greenlight.Sdk" Version="1.2.0" />
  </ItemGroup>

</Project>
